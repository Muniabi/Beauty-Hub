# Copy to .env and fill in real values. Never commit .env.

DOMAIN="beautyrostov.mooo.com"
ACME_EMAIL="you@example.com"

# Mongo inside Docker. Use letters and digits only in the password.
MONGO_USER="beauty"
MONGO_PASSWORD="replace-with-random-mongo-password"
MONGODB_URI="mongodb://localhost:27017/beauty_hub"

# Signed session cookie (min 32 characters)
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Telegram Login (server). Never expose the bot token to the client.
TELEGRAM_BOT_TOKEN="replace-with-bot-token"

# Public bot username without @ — used only by the Login Widget
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="BeautyHubRostovBot"

# Public HTTPS origin. Production:
NEXT_PUBLIC_APP_URL="https://beautyrostov.mooo.com"

# Telegram webhook secret (1-256 chars: A-Z a-z 0-9 _ -)
TELEGRAM_WEBHOOK_SECRET="replace-with-random-token"
